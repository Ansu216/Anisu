<?xml version="1.0" encoding="utf-8"?>
<!--
  Ansu's notification small icon.

  Android tints a notification icon and keeps only its alpha channel, and it draws
  it at ~24dp. The adaptive launcher foreground (`ic_launcher_foreground`) is laid
  out for a 108dp canvas with the artwork in the middle ~26% of it, so using it
  here renders the glyph at a few dp — it reads as a dot, or as nothing at all on
  some devices. This is the same ring + play mark, drawn full-bleed for 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Kernel ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:pathData="M12,2.5 A9.5,9.5 0 1,1 11.99,2.5 Z" />
    <!-- Play mark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,7.5 L10,16.5 L16.5,12 Z" />
</vector>
